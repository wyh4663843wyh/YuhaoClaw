# =====================================================================
# 环境变量示例 —— 复制为 .env 或直接导出到环境变量
# .env 路径可用 XHS_ENV_FILE 指定（默认 ~/.baoyu-skills/.env）
# ⚠️ 真实密钥只写进你的本地 .env / 环境变量，**绝不提交到 git**
# =====================================================================

# --- 小红书设备（uiautomator2 真机） ---
# 设备序列号：adb devices 查看。或写进 interceptor/console/lanes.yaml 的 accounts
XHS_DEVICE=YOUR_DEVICE_SERIAL

# 主动获客搜索关键词（也可是 CLI 参数 --kw）
XHS_KW=你的搜索词

# --- LLM Provider（回复拟稿/润色；缺省走 deepseek→glm→minimax 链） ---
# 选择器（可选）：REPLY_LLM_PROVIDER = minimax | deepseek | zhipu
REPLY_LLM_PROVIDER=deepseek

# 各 provider 的 API Key（按你用的填；均有默认 API 地址，可按需覆盖 base）
DEEPSEEK_API_KEY=sk-your-deepseek-key
MINIMAX_API_KEY=your-minimax-key
ZHIPU_API_KEY=your-zhipu-key

# --- 服务端口（默认 8090） ---
# XHS_CONSOLE_PORT=8090
